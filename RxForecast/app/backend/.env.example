# Copy to .env and fill in once you have a provisioned Azure AI Foundry project
# (lld.md §4.5). All values optional — leaving them unset keeps the app on its
# existing template/simulated behavior (GAPS.md "AI reasoning").

# Azure AI Foundry — model deployment (foundryClient.js). FOUNDRY_ENDPOINT: either the
# resource root (https://<resource>.services.ai.azure.com) or the portal's "Project
# endpoint" (.../api/projects/<name>) — foundryClient.js strips the /api/projects/...
# suffix itself, so either form works. FOUNDRY_DEPLOYMENT_NAME is the deployment name
# from Models + endpoints, not the underlying model name.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT_NAME=
FOUNDRY_API_VERSION=2024-05-01-preview

# Azure AI Content Safety — groundedness gate (contentSafety.js)
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
CONTENT_SAFETY_API_VERSION=2024-09-15-preview
# lld.md §12.8 — open decision, tune against real output before trusting this default.
CONTENT_SAFETY_UNGROUNDED_THRESHOLD=0.5

# Live openFDA shortage feed (shortageFeed.js) — free, no key strictly required.
# Set SHORTAGE_FEED_ENABLED=true to replace the synthetic shortage list with real,
# live-polled data from api.fda.gov. Expect few/zero matches against this prototype's
# trimmed 60-NDC formulary — see shortageFeed.js's header comment, that's expected.
SHORTAGE_FEED_ENABLED=false
SHORTAGE_FEED_POLL_MINUTES=15
FDA_OPENFDA_API_KEY=

PORT=4000
